{
  "name": "rspress-doc-template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run copy-styles && rspress dev",
    "build": "npm run copy-styles && rspress build",
    "update": "rspress update",
    "genestyle": "npx tailwindcss -i ./theme/input.css -o ./theme/output.css",
    "copy-styles": "npx tailwindcss -i ./theme/input.css -o ./theme/output.css && copy theme\\output.css docs\\public\\theme\\output.css",
    "preview": "rspress preview"
  },
  "dependencies": {
    "@giscus/react": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^16",
    "rspress": "^1.44.0",
    "tailwindcss": "^3.3.6"
  }
}
